From: slwyts <slwyts@foxmail.com>
Subject: [PATCH] ui/keyboard: add fallback for purpose-specific OSK layouts

_updateLayout() constructs purpose-specific KeyboardModel instances
(digits, number, phone, email, url) without try/catch. If the layout
resource is missing or malformed, the exception escapes and the entire
on-screen keyboard fails to appear — but only for those purposes.
Password fields (purpose=PASSWORD) take the else branch which already
has per-candidate try/catch and falls back to 'us', so they work fine.

This produces the asymmetric symptom: password fields show the keyboard,
phone-number fields do not.

Fix:
- Build a candidate list [purposeModel, groupName, groupName-base, 'us']
  and iterate with try/catch, matching the else branch's behaviour.
- Validate `levels` in the KeyboardModel constructor so a parseable but
  unusable JSON becomes a catchable error instead of a later TypeError
  in getLevels().

When the purpose layout loads successfully, behaviour is unchanged.

Applies to upstream GNOME Shell 48.7 (gnome-48 branch).
Debian 13 source: gnome-shell 48.7-0+deb13u2.

Origin: https://gitlab.gnome.org/GNOME/gnome-shell/-/blob/gnome-48/js/ui/keyboard.js
Forwarded: no
---
--- a/js/ui/keyboard.js
+++ b/js/ui/keyboard.js
@@ -466,6 +466,9 @@
 class KeyboardModel {
     constructor(groupName) {
         this._model = this._loadModel(groupName);
+        if (!this._model || !Array.isArray(this._model.levels) ||
+            !this._model.levels.length)
+            throw new Error(`Invalid OSK layout: ${groupName}`);
     }
 
     _loadModel(groupName) {
@@ -1411,38 +1414,41 @@
             y_expand: true,
         });
 
-        if (purpose === Clutter.InputContentPurpose.DIGITS) {
-            keyboardModel = new KeyboardModel('digits');
-        } else if (purpose === Clutter.InputContentPurpose.NUMBER) {
-            keyboardModel = new KeyboardModel('number');
-        } else if (purpose === Clutter.InputContentPurpose.PHONE) {
-            keyboardModel = new KeyboardModel('phone');
-        } else if (purpose === Clutter.InputContentPurpose.EMAIL) {
-            keyboardModel = new KeyboardModel('email');
-        } else if (purpose === Clutter.InputContentPurpose.URL) {
-            keyboardModel = new KeyboardModel('url');
-        } else {
-            let groups = [groupName];
-            if (groupName.includes('+'))
-                groups.push(groupName.replace(/\+.*/, ''));
-            groups.push('us');
-
-            if (purpose === Clutter.InputContentPurpose.TERMINAL)
-                groups = groups.map(g => `${g}-extended`);
-
-            for (const group of groups) {
-                try {
-                    keyboardModel = new KeyboardModel(group);
-                    break;
-                } catch {
-                    // Ignore this error and fall back to next model
-                }
-            }
+        const purposeModels = {
+            [Clutter.InputContentPurpose.DIGITS]: 'digits',
+            [Clutter.InputContentPurpose.NUMBER]: 'number',
+            [Clutter.InputContentPurpose.PHONE]: 'phone',
+            [Clutter.InputContentPurpose.EMAIL]: 'email',
+            [Clutter.InputContentPurpose.URL]: 'url',
+        };
 
-            if (!keyboardModel)
-                return;
+        let candidates = [];
+        const purposeModel = purposeModels[purpose];
+        if (purposeModel)
+            candidates.push(purposeModel);
+
+        let groups = [groupName];
+        if (groupName.includes('+'))
+            groups.push(groupName.replace(/\+.*/, ''));
+        groups.push('us');
+
+        if (purpose === Clutter.InputContentPurpose.TERMINAL)
+            groups = groups.map(g => `${g}-extended`);
+
+        candidates.push(...groups);
+
+        for (const candidate of candidates) {
+            try {
+                keyboardModel = new KeyboardModel(candidate);
+                break;
+            } catch {
+                // Ignore and fall back to next candidate
+            }
         }
 
+        if (!keyboardModel)
+            return;
+
         const emojiVisible = Meta.is_wayland_compositor() &&
             (purpose === Clutter.InputContentPurpose.NORMAL ||
              purpose === Clutter.InputContentPurpose.ALPHA ||
