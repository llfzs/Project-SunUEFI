// The GNOME user service piano-sensor-power stops iio-sensor-proxy while
// neither screen rotation nor automatic brightness needs a sensor, and starts
// it again when one does. That is the only privilege it needs: managing this
// single unit. Everything else keeps its existing policy.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "iio-sensor-proxy.service" &&
        subject.local && subject.active &&
        (subject.isInGroup("piano") || subject.isInGroup("wheel") ||
         subject.isInGroup("sudo"))) {
        return polkit.Result.YES;
    }
    return undefined;
});
