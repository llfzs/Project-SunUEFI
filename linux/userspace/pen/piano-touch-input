#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause-Patent
# One THP reader; select calibration using the actual touch controller LCD ID.
set -eu
# Pen support keeps the controller in stylus scanning mode, which reports at
# roughly 120 interrupts/s even when nothing touches the panel, and runs the
# pen radio companion. It is opt-in on this board: without /etc/piano/pen the
# reader stays finger-only, so a freshly flashed image never pays that idle
# cost for a pen that may not be there. Enable it with `piano-pen-mode pen`.
if [ ! -e /etc/piano/pen ]; then
  echo 0 > /proc/nvt_thp_stylus 2>/dev/null || true
  exec /usr/bin/piano-touch-view input --seconds 0
fi
# This companion shares piano-touch.service's process group. It does not read
# THP data or emit input; it restores actual pen radio/haptic settings after
# BlueZ reconnects. systemd stops it together with the touch owner.
if [ -x /usr/lib/piano/pen-bluetooth ] && [ -r /usr/share/piano/pen/p81c-radio.json ]; then
  /usr/lib/piano/pen-bluetooth --profile /usr/share/piano/pen/p81c-radio.json \
    --stationary-device /proc/nvt_thp_pen_stationary --follow &
fi
lcd_id=$(awk '/^lcd_id:/{print $2}' /proc/nvt_thp_status 2>/dev/null || true)
case "$lcd_id" in
  0) calibration=/usr/share/piano/pen/calibration/piano-csot.ini ;;
  1) calibration=/usr/share/piano/pen/calibration/piano-boe.ini ;;
  *) calibration= ;;
esac
if [ -n "$calibration" ] && [ -r "$calibration" ]; then
  if echo 3 > /proc/nvt_thp_stylus; then
    exec /usr/bin/piano-touch-view input --seconds 0 \
      --pen-ini "$calibration" --pen-pressure-max-age-ms 100 --pen-input
  fi
  echo 'piano-touch: pen scanning unavailable; starting finger input' >&2
else
  echo 'piano-touch: no calibration for the actual touch LCD ID; starting finger input' >&2
fi
exec /usr/bin/piano-touch-view input --seconds 0
