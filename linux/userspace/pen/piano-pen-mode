#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause-Patent
# Switch the touch controller between pen scanning and finger-only input.
#
# Finger-only is the default: images ship without the marker, so a freshly
# flashed host never leaves the controller in stylus scanning mode (roughly
# 120 interrupts/s even on an untouched panel) and never runs the pen radio
# companion. Pen support is opt-in via `piano-pen-mode pen`.
# piano-touch-input reads the marker at service start, so both actions restart
# piano-touch.service.
set -eu

marker=/etc/piano/pen
# Earlier images used an inverted "no pen" marker; remove it so a host carrying
# both cannot disagree with itself.
legacy=/etc/piano/no-pen

usage() {
  echo "usage: piano-pen-mode [finger|pen|status]" >&2
  exit 2
}

state() {
  if [ -e "$marker" ]; then
    echo pen
  else
    echo finger
  fi
}

case "${1:-status}" in
  status)
    state
    exit 0
    ;;
  finger|pen)
    if [ "$(id -u)" -ne 0 ]; then
      echo "piano-pen-mode: needs root, e.g. sudo piano-pen-mode $1" >&2
      exit 1
    fi
    if [ "$1" = pen ]; then
      mkdir -p "${marker%/*}"
      touch "$marker"
    else
      rm -f "$marker"
    fi
    rm -f "$legacy"
    ;;
  *)
    usage
    ;;
esac

if ! systemctl restart piano-touch.service; then
  echo "piano-pen-mode: piano-touch.service failed to restart" >&2
  exit 1
fi

# The service writes /proc/nvt_thp_stylus and execs the reader right after
# start, so give it a moment before reporting what it actually landed on.
sleep 1
echo "piano-pen-mode: $(state) mode, piano-touch.service $(systemctl is-active piano-touch.service 2>/dev/null || echo unknown)"
