# BLE / GATT / HOGP — required for Bluetooth mice (HID over GATT).
CONFIG_BT_LE=y
# Classic HID channel (default m in piano_defconfig; pinned explicitly).
CONFIG_BT_HIDP=m
# BlueZ HID over GATT creates input devices through /dev/uhid.
CONFIG_UHID=m
# P81C private pressure packets are not keyboard plus keys.
CONFIG_HID_XIAOMI=m
# Standard Bluetooth serial channels used by headset control and OBEX.
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
# Bluetooth PAN uses the standard networking backend.
CONFIG_BT_BNEP=m
