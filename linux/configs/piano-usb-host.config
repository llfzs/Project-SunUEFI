# dwc3 host mode registers an "xhci-hcd" platform device; this driver binds it.
CONFIG_USB_XHCI_PLATFORM=y
# Type-C connector → dwc3 role switch provider.
CONFIG_USB_ROLE_SWITCH=y
# Matches piano-usb-typec.dtso dr_mode = "otg".
CONFIG_USB_DWC3_DUAL_ROLE=y
# Class driver for enumerated USB keyboards/mice.
CONFIG_USB_HID=y
# Generic HID report parser (default y; pinned to prevent regression).
CONFIG_HID_GENERIC=y
