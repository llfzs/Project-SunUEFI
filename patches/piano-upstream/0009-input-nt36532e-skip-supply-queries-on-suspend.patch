From 722ec84628367aa3d1f20f64857d7a8d0166de30 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: 2026-10-22T01:45:26Z
Subject: Input: nt36532e-thp - exclude charge pumps and drain supply queries on suspend


SC8541 advertises UNKNOWN type and ONLINE reflects its CHG_EN bit, not an
external supply. Exclude UNKNOWN devices along with batteries and
device-scope supplies. Add the charge-pump negative control to KUnit.

Power-supply property getters can perform bus transactions. Use a
freezable queue to avoid racing other devices during system PM. Gate the work
on system suspend and drain it even when the panel was already off; the
resume stream start still resamples the external supply. Screen-off state
changes remain cached while the system is awake.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>

diff --git a/drivers/input/touchscreen/nt36532e-thp/README.rst b/drivers/input/touchscreen/nt36532e-thp/README.rst
--- a/drivers/input/touchscreen/nt36532e-thp/README.rst
+++ b/drivers/input/touchscreen/nt36532e-thp/README.rst
@@ -186,13 +186,18 @@ in https://github.com/blu-sharky/linux-piano at
 ``drivers/input/touchscreen/nt36532e/nt36xxx.c`` (GPL-2.0-or-later).
 
 Only a readable external, system-scope power supply's ONLINE property determines
-the state. Batteries, device-scope supplies and USB enumeration do not count.
+the state. Batteries, UNKNOWN-type internal charge pumps, device-scope supplies
+and USB enumeration do not count. In particular, SC8541 ONLINE is CHG_EN,
+not cable presence.
 With no readable ONLINE property, the previous state is retained. Notifications
-queue work under the existing lifecycle mutex; regmap protects each page/write
+queue freezable work under the existing lifecycle mutex; regmap protects each page/write
 transaction from concurrent frame reads. The wire sequence is ``ff 23 88`` then
 ``d0 53 00`` (online) or ``d0 51 00`` (offline), at register ``0x11c450``.
 
-A closed, disabled, suspended or failed stream only caches the current state.
+A closed, disabled or failed stream only caches the current state. System
+suspend also drains and gates the supply-query work, because an ONLINE getter
+may itself access a bus. The freezable queue excludes supply queries across
+the system-wide device PM phase; resume samples the current state again.
 Every successful firmware start queues a fresh ONLINE sample after REK, the
 first valid frame, NORMAL_RUN and all three BF commands. It resends once even
 when the state is unchanged; repeated notifications otherwise send nothing.

diff --git a/drivers/input/touchscreen/nt36532e-thp/core.c b/drivers/input/touchscreen/nt36532e-thp/core.c
--- a/drivers/input/touchscreen/nt36532e-thp/core.c
+++ b/drivers/input/touchscreen/nt36532e-thp/core.c
@@ -276,7 +276,8 @@ static int nvt_external_supply(struct power_supply *psy, void *data)
 	union power_supply_propval value;
 	int *online = data;
 
-	if (psy->desc->type == POWER_SUPPLY_TYPE_BATTERY)
+	if (psy->desc->type == POWER_SUPPLY_TYPE_BATTERY ||
+	    psy->desc->type == POWER_SUPPLY_TYPE_UNKNOWN)
 		return 0;
 	if (!power_supply_get_property(psy, POWER_SUPPLY_PROP_SCOPE, &value) &&
 	    value.intval == POWER_SUPPLY_SCOPE_DEVICE)
@@ -322,7 +323,7 @@ static void nvt_charger_work(struct work_struct *work)
 	int online = -ENODEV;
 
 	mutex_lock(&nvt->lifecycle_lock);
-	if (!READ_ONCE(nvt->dead)) {
+	if (!READ_ONCE(nvt->dead) && !READ_ONCE(nvt->suspended)) {
 		power_supply_for_each_psy(&online, nvt_external_supply);
 		nvt_charger_state(nvt, online);
 	}
@@ -334,7 +335,7 @@ static int nvt_charger_notify(struct notifier_block *nb, unsigned long event, vo
 	struct nvt_thp *nvt = container_of(nb, struct nvt_thp, charger_notifier);
 
 	if (event == PSY_EVENT_PROP_CHANGED)
-		schedule_work(&nvt->charger_work);
+		queue_work(system_freezable_wq, &nvt->charger_work);
 	return NOTIFY_OK;
 }
 
@@ -472,7 +473,7 @@ static int nvt_start_stream(struct nvt_thp *nvt)
 		 nvt->reset_state, state_ret, first_frame_state, normal_run_ms);
 	/* Firmware reload loses the setting, even if ONLINE has not changed. */
 	nvt->charger_sent = -1;
-	schedule_work(&nvt->charger_work);
+	queue_work(system_freezable_wq, &nvt->charger_work);
 	return 0;
 stop:
 	nvt_stop_irq(nvt);
@@ -773,7 +774,7 @@ static int nvt_probe(struct spi_device *spi)
 	if (ret)
 		return ret;
 	/* Cache the initial state without starting the transport or issuing I/O. */
-	schedule_work(&nvt->charger_work);
+	queue_work(system_freezable_wq, &nvt->charger_work);
 	nvt->misc.minor = MISC_DYNAMIC_MINOR;
 	nvt->misc.fops = &nvt_fops;
 	nvt->misc.parent = &spi->dev;
@@ -824,6 +825,9 @@ static int nvt_suspend(struct device *dev)
 	/* A disabled panel has already cancelled work and stopped its IRQ. */
 	if (!nvt->dead && !panel_off)
 		nvt_quiesce(nvt);
+	else
+		/* ONLINE callbacks may query other devices: drain even with panel off. */
+		cancel_work_sync(&nvt->charger_work);
 	mutex_unlock(&nvt->transition_lock);
 	return 0;
 }
@@ -1364,6 +1368,9 @@ static void nvt_test_charger_external_online(struct kunit *test)
 	ctx->desc.type = POWER_SUPPLY_TYPE_BATTERY;
 	KUNIT_EXPECT_EQ(test, nvt_external_supply(&ctx->psy, &online), 0);
 	KUNIT_EXPECT_EQ(test, online, 0);
+	ctx->desc.type = POWER_SUPPLY_TYPE_UNKNOWN;
+	KUNIT_EXPECT_EQ(test, nvt_external_supply(&ctx->psy, &online), 0);
+	KUNIT_EXPECT_EQ(test, online, 0);
 	ctx->desc.type = POWER_SUPPLY_TYPE_USB;
 	ctx->scope = POWER_SUPPLY_SCOPE_DEVICE;
 	KUNIT_EXPECT_EQ(test, nvt_external_supply(&ctx->psy, &online), 0);

