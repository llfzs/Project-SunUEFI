From 24142165d4f9485adc4bd2baf38395a8fb9cdc32 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: 2026-10-14T02:03:14Z
Subject: HID: nanosic: replace periodic keyboard wake with an attach command


Remove the 12-second self-rescheduling wake_worker, including its probe,
suspend, detach and teardown plumbing. Send the command once on attach;
the following lifecycle change will gate it on panel and system state.

The stock Android implementation uses a 10-second keep-awake only during
authentication. It does not establish a periodic power command as a
normal input requirement. Our earlier P25 transport delivered real key
reports without periodic wake. Restarting the community timer after PM
would therefore hide the unimplemented panel power lifecycle rather than
explain the observed accessory-side loss of HID reports.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>

diff --git a/drivers/hid/hid-nanosic-wn8030-test.c b/drivers/hid/hid-nanosic-wn8030-test.c
--- a/drivers/hid/hid-nanosic-wn8030-test.c
+++ b/drivers/hid/hid-nanosic-wn8030-test.c
@@ -45,7 +45,6 @@ static void wn8030_test_cleanup(void *data)
 {
 	struct nanosic_wn8030 *nano = data;
 
-	cancel_delayed_work_sync(&nano->wake_worker);
 	cancel_work_sync(&nano->input_state_work);
 	if (nano->hid_keyboard)
 		hid_destroy_device(nano->hid_keyboard);
@@ -96,7 +95,6 @@ static int wn8030_test_init(struct kunit *test)
 		return PTR_ERR(nano->regmap);
 	mutex_init(&nano->conn_mutex);
 	init_completion(&nano->attach_known);
-	INIT_DELAYED_WORK(&nano->wake_worker, nanosic_wn8030_wake_worker);
 	INIT_WORK(&nano->input_state_work, nanosic_wn8030_input_state_work);
 	spin_lock_init(&nano->hinge_lock);
 	init_waitqueue_head(&nano->hinge_read_wq);
@@ -166,7 +164,6 @@ static void wn8030_attach_switch_and_no_touchpad(struct kunit *test)
 	nanosic_wn8030_handle_vendor(nano, report, sizeof(report));
 	KUNIT_EXPECT_TRUE(test, test_bit(SW_TABLET_MODE, nano->tablet->sw));
 	KUNIT_EXPECT_PTR_EQ(test, nano->hid_keyboard, NULL);
-	KUNIT_EXPECT_FALSE(test, delayed_work_pending(&nano->wake_worker));
 	report[9] = 3;
 	nanosic_wn8030_handle_vendor(nano, report, sizeof(report));
 	KUNIT_ASSERT_NOT_NULL(test, nano->hid_keyboard);

