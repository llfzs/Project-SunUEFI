+/* Candidate 3x3 maxima for one frame.  Named type at file scope so qsort()'s
+ * comparator can see it.  `held' marks a peak that belongs to an already
+ * tracked contact, `order' is the scan index of the peak node.
+ */
+struct peak_cand {
+	double x, y;
+	int peak;
+	int held;
+	int order;
+};
+
+/* Ordering: tracked contact first, then stronger, then earlier in the scan.
+ *
+ * The sensor matrix is ~40x60 over a 3200x2136 panel, so one cell is ~53 px.
+ * When a finger sits between two diagonal neighbours of (almost) equal delta,
+ * the 3x3 maximum and the centroid window hop between those two nodes from
+ * frame to frame, and x and y jump at the same time: a diagonal drag jitters,
+ * a horizontal one does not, because there the winner stays in the same row.
+ * Sorting by strength alone keeps that flip alive for the two candidates that
+ * already belong to a tracked contact.  Putting `held' first means the peak
+ * the tracker is already following always wins, and `order' turns every
+ * remaining tie into a deterministic, frame-independent choice.
+ */
+static int cmp_peak(const void *a, const void *b)
+{
+	const struct peak_cand *pa = a, *pb = b;
+
+	if (pa->held != pb->held)
+		return pb->held - pa->held;
+	if (pa->peak != pb->peak)
+		return pb->peak - pa->peak;
+	return pa->order - pb->order;
+}
