+/* first-order low-pass with snap bypass for fast movement */
+static void slot_move(int s, int nx, int ny)
+{
+	int dx = nx - trk.slot[s].x, dy = ny - trk.slot[s].y;
+	int dist2 = dx * dx + dy * dy;
+
+	trk.slot[s].px = trk.slot[s].x;
+	trk.slot[s].py = trk.slot[s].y;
+
+	if (dist2 > SMOOTH_SNAP_DIST * SMOOTH_SNAP_DIST) {
+		trk.slot[s].x = nx;
+		trk.slot[s].y = ny;
+		trk.slot[s].sx = (int32_t)nx << 8;
+		trk.slot[s].sy = (int32_t)ny << 8;
+	} else {
+		trk.slot[s].sx += ((int32_t)(nx << 8) - trk.slot[s].sx) * SMOOTH_ALPHA / 256;
+		trk.slot[s].sy += ((int32_t)(ny << 8) - trk.slot[s].sy) * SMOOTH_ALPHA / 256;
+		trk.slot[s].x = (int)((trk.slot[s].sx + 128) >> 8);
+		trk.slot[s].y = (int)((trk.slot[s].sy + 128) >> 8);
+	}
+}
