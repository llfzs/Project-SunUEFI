+#define PEAK_MIN_DIST 2		/* suppress weaker peaks within this cell distance */
+#define SMOOTH_ALPHA 64		/* low-pass numerator /256; smaller = smoother */
+/* The centroid window is truncated at the peak cell, so the reported position
+ * walks a staircase of half a sensor cell (26.7 px here: 3200/60 and 2136/40)
