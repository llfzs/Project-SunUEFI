+#define PEAK_MIN_DIST 2		/* suppress weaker peaks within this cell distance */
+#define SMOOTH_ALPHA 96		/* low-pass numerator /256; smaller = smoother */
+#define SMOOTH_SNAP_DIST 24	/* px; bypass filter above this inter-frame move */
 
